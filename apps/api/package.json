{
  "name": "@repo/api",
  "type": "module",
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx auth@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.7.6",
    "better-auth-devtools": "^1.1.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.11",
    "hono-problem-details": "^0.11.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.70.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  }
}
