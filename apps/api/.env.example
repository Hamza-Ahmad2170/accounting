# Server
PORT=3001
NODE_ENV=development

# Origin of the front-end (apps/web). Used for CORS and Better Auth trustedOrigins.
WEB_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting

# Better Auth
BETTER_AUTH_SECRET=your-random-32-char-secret-key-goes-here
BETTER_AUTH_URL=http://localhost:3001
